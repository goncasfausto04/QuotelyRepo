# ---- Required ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key: secret, server only. Never put it in the frontend or in git.
SUPABASE_SERVICE_KEY=
GEMINI_API_KEY=

# Frontend origin(s) allowed by CORS, comma separated (also used to build supplier links)
FRONTEND_URL=https://quotely-repo.vercel.app
# Also allow your own Vercel deployment/preview URLs (hostname suffix, comma separated)
ALLOWED_ORIGIN_SUFFIXES=-goncasfausto04s-projects.vercel.app

# Optional: override the Gemini model
# GEMINI_MODEL=gemini-2.5-flash

# ---- Email (Gmail API) ----
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
# Get one with: npm run gmail:token
GMAIL_API_REFRESH_TOKEN=
GMAIL_API_SENDER=you@gmail.com

# ---- Supplier search (Google Programmable Search) ----
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ---- Admin dashboard (/admin) ----
# Comma separated emails of accounts that may open /admin
ADMIN_EMAILS=

# ---- Email mode ----
# Default when the app_settings table has no value yet (switch it at /admin):
#   test = emails go to GMAIL_API_SENDER + automatic dummy supplier reply (all values 999)
#   live = emails go to the real suppliers
EMAIL_MODE=test
# Delay before the dummy reply is sent in test mode
# DUMMY_REPLY_DELAY_MS=5000
