# ---- Required ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key: secret, server only. Never put it in the frontend or in git.
SUPABASE_SERVICE_KEY=
GEMINI_API_KEY=

# Frontend origin(s) allowed by CORS, comma separated (also used to build supplier links)
FRONTEND_URL=https://quotely-repo.vercel.app
# Set to true to also allow https://*.vercel.app preview deployments
ALLOW_VERCEL_PREVIEWS=false

# Optional: override the Gemini model
# GEMINI_MODEL=gemini-2.5-flash

# ---- Email (Gmail API) ----
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
# Get one with: npm run gmail:token
GMAIL_API_REFRESH_TOKEN=
GMAIL_API_SENDER=you@gmail.com

# ---- Supplier search (Google Programmable Search) ----
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
